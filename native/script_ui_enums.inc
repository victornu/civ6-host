static int __cdecl namespace_create_enum_tables(LuaState* state,
                                                    const NativeEnumGroup* groups, size_t group_count) {
    th_newtable(state, 0, (int)group_count);
    for (size_t i = 0; i < group_count; ++i) {
        const NativeEnumGroup* group = &groups[i];
        th_newtable(state, 0, (int)group->count);
        for (size_t j = 0; j < group->count; ++j) {
            th_number(state, group->values[j].value);
            th_setfield(state, -2, group->values[j].name);
        }
        th_setfield(state, -2, group->name);
    }
    return 1;
}

static int __cdecl namespace_create_ui_enums(LuaState* state) {
    return namespace_create_enum_tables(state, ui_groups, sizeof(ui_groups)/sizeof(ui_groups[0]));
}

static int __cdecl namespace_create_app_ui_enums(LuaState* state) {
    /* Callback helper 0x1404d7c20 resolves global `AppUIEnumsLibrary`;
     * PopupPriority is its first nested group. */
    return namespace_create_enum_tables(state, app_ui_groups, sizeof(app_ui_groups)/sizeof(app_ui_groups[0]));
}
